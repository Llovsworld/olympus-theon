// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Post {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String
  excerpt         String? // Short summary for listings
  metaDescription String? // SEO meta description
  category        String? // Legacy primary category kept for rollback compatibility
  categories      String[] @default([]) // Controlled editorial categories
  featuredImage   String?
  published       Boolean  @default(false)
  views           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Book {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  author      String? // Book author name
  category    String? // Controlled editorial category
  description String // Short description for listings
  content     String? // Optional long content or details
  coverImage  String?
  link        String?
  published   Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subscriber {
  id                    String    @id @default(cuid())
  email                 String    @unique
  active                Boolean   @default(false)
  consentAt             DateTime?
  consentVersion        String?
  consentSource         String?
  confirmationTokenHash String?   @unique
  confirmationExpiresAt DateTime?
  confirmedAt           DateTime?
  unsubscribedAt        DateTime?
  createdAt             DateTime  @default(now())
}
